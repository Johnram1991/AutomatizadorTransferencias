[
    { "field": "noTransfer", "pattern": "(Z\\d{2}-[A-Z0-9]+-\\d{2,})", "label": "No. Transfer" },
    { "field": "fecha", "pattern": "(\\d{2}-[A-Za-z]{3}-\\d{4})", "label": "Fecha" },
    { "field": "cliente", "pattern": "Despachese a\\s+([A-Za-zÀ-ÿ\\s]+?)\\s+Por confirmar", "label": "Cliente" },
    { "field": "ciudad", "pattern": ",\\s*\\d{4,5}\\s*,\\s*([A-Za-zÀ-ÿ\\s]+?)\\s+[A-Za-zÀ-ÿ]+\\s+Por confirmar", "label": "Ciudad" },
    { "field": "distribuidor", "pattern": "(?i)(COVEGUSA|COFARVET|GRUCOSA)", "label": "Distribuidor" },
    { "field": "monto", "pattern": "Total:\\s*\\$?\\s*([\\d,]+(?:\\.[\\d]{2})?)", "label": "Total" }
]
